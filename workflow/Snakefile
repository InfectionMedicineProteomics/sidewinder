from pathlib import Path

import pandas as pd
from snakemake.utils import min_version


def get_linker_num(wildcards):

    linker_nums = {'DSS': 1,
                   'DSG': 2,
                   'ESG': 3}

    linker_dict = {f'{b}_{t}_{s}': linker_nums[l]
                   for b, t, s, l in zip(ANTIGEN_LIST,
                                         ANTIBODY_LIST,
                                         SAMPLES,
                                         LINKERS)}

    key = '_'.join([wildcards.antigen, wildcards.antibody, wildcards.sample])

    try:

        return linker_dict[key]

    except ValueError:

        raise ValueError(f"No linker found for {key} in the input table.")


